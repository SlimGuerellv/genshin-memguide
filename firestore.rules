rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function validNick(n) { return n is string && n.matches('[a-zA-Z0-9а-яА-ЯёЁіІїЇєЄґҐ][a-zA-Z0-9а-яА-ЯёЁіІїЇєЄґҐ_.-]{2,19}'); }
    function validLow(l) { return l is string && l.matches('[a-z0-9а-яёіїєґ][a-z0-9а-яёіїєґ_.-]{2,19}'); }

    // Публичный профиль: только ник
    match /users/{uid} {
      allow read: if true;
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['nick', 'nickLower', 'updatedAt'])
        && validNick(request.resource.data.nick)
        && validLow(request.resource.data.nickLower)
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/nicks/$(request.resource.data.nickLower)).data.uid == uid;
      allow delete: if false;

      // Личное: коллекция — видит и меняет только владелец
      match /private/{docId} {
        allow read: if isMe(uid);
        allow write: if isMe(uid) && docId == 'coll'
          && request.resource.data.keys().hasOnly(['c', 'updatedAt'])
          && request.resource.data.c is map
          && request.resource.data.c.size() <= 500;
      }
    }

    // Занятые ники (для уникальности)
    match /nicks/{nickLower} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.nickLower == nickLower;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.nickLower != nickLower;
      allow update: if false;
    }

    // Комментарии к персонажам
    match /comments/{charId}/items/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && charId.size() <= 60
        && request.resource.data.keys().hasOnly(['uid', 'nick', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nick == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.nick
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Отзывы / баги / идеи: писать может любой (без входа), читать — все, менять и удалять — только через консоль
    match /feedback/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['type', 'text', 'name', 'page', 'env', 'createdAt'])
        && request.resource.data.keys().hasAll(['type', 'text', 'name', 'page', 'env', 'createdAt'])
        && request.resource.data.type in ['review', 'bug', 'idea']
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 3
        && request.resource.data.text.size() <= 1000
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 30
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 40
        && request.resource.data.env is string
        && request.resource.data.env.size() <= 160
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Всё остальное закрыто
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
